# Copy this file to `.env` and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API). `.env` is gitignored and must
# never be committed.
#
# Both values are exposed in the client bundle by Vite, so the publishable
# (anon) key is only safe when row level security is enabled on every table.
# Never put the service role key in this file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# There is no barangay setting here any more. One database now holds every
# barangay in the Rural Health Unit, so an export names the barangay it actually
# covers -- read from the rows, per the signed-in account's scope -- rather than
# whichever name a bundle happened to be compiled with.

# Host port the admin portal container publishes on. Compose only; the BHW
# client never reads it.
ADMIN_PORT=8080

# Cloudflare Turnstile site key for the sign-in captcha (Cloudflare dashboard ->
# Turnstile). Public, like the publishable key. Leave empty to build without a
# captcha -- fine for development, but once Supabase enforces captcha
# (Authentication -> Attack Protection) every build that signs in needs it, the
# APK included. The widget's hostnames must list the portal's domain and
# `localhost`, which is where the APK's WebView serves from.
VITE_TURNSTILE_SITE_KEY=
