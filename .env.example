# Copy this file to `.env` and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API). `.env` is gitignored and must
# never be committed.
#
# Both values are exposed in the client bundle by Vite, so the publishable
# (anon) key is only safe when row level security is enabled on every table.
# Never put the service role key in this file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# The barangay this deployment serves. Printed on the face of every exported
# LGU report, so it must match the barangay's official name. There is no
# default: a report carrying the wrong barangay is worse than one that says the
# name is missing.
VITE_BARANGAY_NAME=Barangay Example
